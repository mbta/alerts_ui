{
  "info": {
    "version": "1.0",
    "title": "AlertsUI"
  },
  "host": "localhost:4000",
  "definitions": {
    "InformedEntity": {
      "description": "Body for InformedEntity to be included with Alert",
      "properties": {
        "activities": {
          "description": "string",
          "type": "array"
        },
        "agency_id": {
          "description": "Agency ID",
          "type": "string"
        },
        "direction_id": {
          "description": "Direction ID",
          "enum": [
            0,
            1
          ],
          "type": "integer"
        },
        "facility_id": {
          "description": "Facility ID",
          "type": "string"
        },
        "route_id": {
          "description": "Route ID",
          "type": "string"
        },
        "route_type": {
          "description": "Route Type",
          "type": "integer"
        },
        "stop_id": {
          "description": "Stop ID",
          "type": "string"
        },
        "trip": {
          "description": "Trip included with Informed Entity",
          "items": {
            "$ref": "#/definitions/Trip"
          },
          "type": "array"
        }
      },
      "title": "InformedEntity",
      "type": "object"
    },
    "Trip": {
      "description": "TripDescriptor optionally included with Informed Entity",
      "properties": {
        "direction_id": {
          "description": "Direction ID",
          "enum": [
            0,
            1
          ],
          "type": "integer"
        },
        "route_id": {
          "description": "Route ID",
          "type": "string"
        },
        "start_date": {
          "description": "Start Date in format YYYYMMDD",
          "type": "string"
        },
        "start_time": {
          "description": "Start Time in format HH:MM:SS",
          "type": "string"
        },
        "trip_id": {
          "description": "Trip ID",
          "type": "string"
        }
      },
      "title": "TripDescriptor",
      "type": "object"
    },
    "Alert": {
      "description": "Alert information",
      "properties": {
        "cause": {
          "type": "string"
        },
        "cause_detail": {
          "type": "string"
        },
        "description_text": {
          "type": "string"
        },
        "effect": {
          "description": "The effect of this problem on the affected entity.",
          "type": "string"
        },
        "effect_detail": {
          "description": "Description of the effect of the alert that allows for agency-specific language",
          "type": "string"
        },
        "header_text": {
          "description": "Header for the alert.",
          "type": "string"
        },
        "informed_entity": {
          "description": "Array of Informed Entities",
          "items": {
            "$ref": "#/definitions/InformedEntity"
          },
          "type": "array"
        },
        "severity_level": {
          "type": "string"
        },
        "url": {
          "description": "The URL which provides additional information about the alert.",
          "type": "string"
        }
      },
      "required": [
        "informed_entity",
        "effect_detail",
        "description_text",
        "header_text"
      ],
      "title": "Alert",
      "type": "object"
    },
    "AlertError": {
      "description": "send upon error in alert creation",
      "properties": {
        "error": {
          "type": "object"
        }
      },
      "title": "AlertError",
      "type": "object"
    },
    "AlertRequest": {
      "description": "POST body for creating a user",
      "properties": {
        "alert": {
          "$ref": "#/definitions/Alert",
          "description": "The alert details"
        }
      },
      "title": "AlertRequest",
      "type": "object"
    },
    "AlertResponse": {
      "description": "send upon successful alert",
      "properties": {
        "alert_id": {
          "type": "string"
        },
        "result": {
          "type": "string"
        }
      },
      "title": "AlertResponse",
      "type": "object"
    },
    "UnauthenticatedError": {
      "description": "send upon returning a 401",
      "properties": {
        "error": {
          "type": "string"
        }
      },
      "title": "AlertError",
      "type": "object"
    }
  },
  "paths": {
    "/api/alerts": {
      "post": {
        "consumes": [
          "application/json"
        ],
        "description": "Create a new alert",
        "operationId": "AlertsUIWeb.ApiController.new",
        "parameters": [
          {
            "description": "The alert details",
            "in": "body",
            "name": "alert",
            "required": false,
            "schema": {
              "$ref": "#/definitions/AlertRequest"
            },
            "x-example": {
              "user": {
                "email": "Joe1@mail.com",
                "name": "Joe"
              }
            }
          }
        ],
        "produces": [
          "application/json"
        ],
        "responses": {
          "201": {
            "description": "Created",
            "schema": {
              "$ref": "#/definitions/AlertResponse"
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/AlertError"
            }
          },
          "401": {
            "description": "Unauthorized",
            "schema": {
              "$ref": "#/definitions/UnauthenticatedError"
            }
          },
          "403": {
            "description": "Forbidden",
            "schema": {
              "error": "Forbidden"
            }
          }
        },
        "summary": "",
        "tags": [
          "Api"
        ]
      }
    }
  },
  "swagger": "2.0"
}