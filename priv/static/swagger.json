{
  "info": {
    "version": "1.0",
    "title": "AlertsUI"
  },
  "host": "localhost:4000",
  "definitions": {
    "Alert": {
      "description": "Alert information",
      "properties": {
        "description_text": {
          "description": "Description for the alert.",
          "type": "string"
        },
        "effect": {
          "description": "The effect of this problem on the affected entity.",
          "type": "string"
        },
        "effect_detail": {
          "description": "Description of the effect of the alert that allows for agency-specific language",
          "type": "string"
        },
        "header_text": {
          "description": "Header for the alert.",
          "type": "string"
        },
        "informed_entity": {
          "description": {
            "properties": {
              "agency_id": {
                "description": "Agency ID",
                "type": "string"
              },
              "direction_id": {
                "description": "Direction ID",
                "enum": [
                  0,
                  1
                ],
                "type": "integer"
              },
              "facility_id": {
                "description": "Facility ID",
                "type": "string"
              },
              "route_id": {
                "description": "Route ID",
                "type": "string"
              },
              "route_type": {
                "description": "Route Type",
                "type": "integer"
              },
              "stop_id": {
                "description": "Stop ID",
                "type": "string"
              },
              "trip": {
                "properties": {
                  "direction_id": {
                    "description": "Direction ID",
                    "enum": [
                      0,
                      1
                    ],
                    "type": "integer"
                  },
                  "route_id": {
                    "description": "Route ID",
                    "type": "string"
                  },
                  "start_date": {
                    "description": "YYYYMMDD",
                    "type": "string"
                  },
                  "start_time": {
                    "description": "11:15:35",
                    "type": "string"
                  },
                  "trip_id": {
                    "description": "Trip ID",
                    "type": "string"
                  }
                },
                "type": "object"
              }
            },
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "effect",
        "description_text",
        "header_text"
      ],
      "title": "Alert",
      "type": "object"
    },
    "AlertRequest": {
      "description": "POST body for creating a user",
      "properties": {
        "alert": {
          "$ref": "#/definitions/Alert",
          "description": "The alert details"
        }
      },
      "title": "AlertRequest",
      "type": "object"
    },
    "AlertResponse": {
      "description": "send upon successful alert",
      "properties": {
        "alert_id": {
          "type": "string"
        },
        "result": {
          "type": "string"
        }
      },
      "title": "AlertResponse",
      "type": "object"
    },
    "AlertError": {
      "description": "send upon error in alert creation",
      "properties": {
        "error": {
          "type": "map"
        }
      },
      "title": "AlertError",
      "type": "object"
    }
  },
  "paths": {
    "/api/alerts": {
      "post": {
        "consumes": [
          "application/json"
        ],
        "description": "Create a new alert",
        "operationId": "AlertsUIWeb.ApiController.new",
        "parameters": [
          {
            "description": "The alert details",
            "in": "body",
            "name": "alert",
            "required": false,
            "schema": {
              "$ref": "#/definitions/AlertRequest"
            },
            "x-example": {
              "user": {
                "email": "Joe1@mail.com",
                "name": "Joe"
              }
            }
          }
        ],
        "produces": [
          "application/json"
        ],
        "responses": {
          "201": {
            "description": "Created",
            "schema": {
              "$ref": "#/definitions/AlertResponse"
            }
          },
          "400": {
            "description": "Bad Request",
            "schema": {
              "$ref": "#/definitions/AlertError"
            }
          },
          "401": {
            "description": {
              "error": "unauthenticated"
            }
          },
          "403": {
            "description": {
              "error": "unauthorized"
            }
          }
        },
        "summary": "",
        "tags": [
          "Api"
        ]
      }
    }
  },
  "swagger": "2.0"
}