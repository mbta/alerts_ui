<section class="m-12">
  <.h1 class="mb-0 text-3x1 text-text-primary">Session expired</.h1>
  <p class="mb-4">Your session has expired. Please log in again.</p>
  <.button_primary_link href={@href} class="whitespace-nowrap">
    <span class="font-medium">
      Log in
    </span>
  </.button_primary_link>
</section>
