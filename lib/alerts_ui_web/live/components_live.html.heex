<div class="p-16">
  <.h1>Components Style Guide</.h1>

  <.h2>Colors</.h2>

  <.h3>Primitive Colors</.h3>

  <div class="inline-grid gap-6 grid-flow-col">
    <.color_block name="primary" class="bg-primary" />
    <.color_block name="primary-hover" class="bg-primary-hover" />
    <.color_block name="primary-active" class="bg-primary-active" />
    <.color_block name="primary-disabled" class="bg-primary-disabled" />
    <.color_block name="secondary" class="bg-secondary" />
    <.color_block name="secondary-hover" class="bg-secondary-hover" />
    <.color_block name="secondary-active" class="bg-secondary-active" />
    <.color_block name="secondary-focus-shadow" class="bg-secondary-focus-shadow" />
    <.color_block name="secondary-disabled" class="bg-secondary-disabled" />
    <.color_block name="success" class="bg-success" />
    <.color_block name="warning" class="bg-warning" />
    <.color_block name="danger" class="bg-danger" />
  </div>

  <.h3>Background Colors</.h3>

  <div class="inline-grid gap-6 grid-flow-col">
    <.color_block name="bg-primary" class="bg-bg-primary" />
    <.color_block name="bg-secondary" class="bg-bg-secondary" />
    <.color_block name="bg-elevation-3" class="bg-bg-elevation-3" />
    <.color_block name="bg-elevation-4" class="bg-bg-elevation-4" />
    <.color_block name="bg-elevation-5" class="bg-bg-elevation-5" />
    <.color_block name="bg-elevation-6" class="bg-bg-elevation-6" />
    <.color_block name="bg-input-default" class="bg-bg-input-default" />
    <.color_block name="danger-active" class="bg-danger-active" />
    <.color_block name="danger-hover" class="bg-danger-hover" />
    <.color_block name="danger-disabled" class="bg-danger-disabled" />
    <.color_block name="toggle-active" class="bg-toggle-active" />
  </div>

  <.h3>Border Colors</.h3>

  <div class="inline-grid gap-6 grid-flow-col">
    <.color_block name="border-primary" class="bg-border-primary" />
    <.color_block name="primary-border-hover" class="bg-primary-border-hover" />
    <.color_block name="border-focus" class="bg-border-focus" />
    <.color_block name="border-disabled" class="bg-border-disabled" />
    <.color_block name="secondary-border" class="bg-secondary-border" />
    <.color_block name="secondary-hover-border" class="bg-secondary-hover-border" />
    <.color_block name="secondary-focus-borde" class="bg-secondary-focus-border" />
  </div>

  <.h3>Menu Colors</.h3>
  <div class="inline-grid gap-6 grid-flow-col">
    <.color_block name="menu-active" class="bg-menu-active" />
  </div>

  <.h3>Text Colors</.h3>

  <div class="inline-grid gap-6 grid-flow-col">
    <.color_block name="text-primary" class="bg-text-primary" />
    <.color_block name="text-secondary" class="bg-text-secondary" />
    <.color_block name="text-danger" class="bg-text-danger" />
    <.color_block name="text-primary-disabled" class="bg-text-primary-disabled" />
    <.color_block name="text-danger-disabled" class="bg-text-danger-disabled" />
    <.color_block name="text-toggle-disabled" class="bg-text-toggle-disabled" />
    <.color_block name="text-disabled" class="bg-text-disabled" />
    <.color_block name="text-select-disabled" class="bg-text-select-disabled" />
    <.color_block name="text-link-outline" class="bg-text-link-outline" />
    <.color_block name="text-error" class="bg-text-error" />
    <.color_block name="text-invert" class="bg-text-invert" />
    <.color_block name="text-white" class="bg-text-white" />
    <.color_block name="text-dark" class="bg-text-dark" />
  </div>

  <.h3>MBTA Service Colors</.h3>

  <div class="inline-grid gap-6 grid-flow-col">
    <.color_block name="mbta-commuter-rail" class="bg-mbta-commuter-rail" />
    <.color_block name="mbta-subway" class="bg-mbta-subway" />
    <.color_block name="mbta-bus" class="bg-mbta-bus" />
    <.color_block name="mbta-ferry" class="bg-mbta-ferry" />
    <.color_block name="mbta-the-ride" class="bg-mbta-the-ride" />
    <.color_block name="mbta-red" class="bg-mbta-red" />
    <.color_block name="mbta-orange" class="bg-mbta-orange" />
    <.color_block name="mbta-green" class="bg-mbta-green" />
    <.color_block name="mbta-blue" class="bg-mbta-blue" />
    <.color_block name="mbta-access" class="bg-mbta-access" />
    <.color_block name="mbta-silver" class="bg-mbta-silver" />
  </div>

  <.h2>Typography</.h2>

  <.h1>H1 Header</.h1>
  <.h2>H2 Header</.h2>
  <.h3>H3 Header</.h3>
  <.h4>H4 Header</.h4>
  <.h5>H5 Header</.h5>
  <.h6>H6 Header</.h6>

  <.p>
    Paragraph text. Lorem ipsum dolor sit amet, consectetur adipiscing elit. Cras consequat erat nec enim ultrices bibendum. Nulla fermentum felis in ultrices tincidunt. Donec luctus placerat neque, eu porta ante aliquam vitae. Cras consequat tristique vulputate. Morbi at erat neque. Suspendisse porttitor erat tellus, in sodales magna faucibus nec. Quisque dignissim enim id metus suscipit luctus. Nunc in cursus nibh, sed tincidunt mauris.
  </.p>

  <.h2>Modal</.h2>
  <.button_primary phx-click={show_modal("example-modal")} class="mb-8 w-[8rem]">
    Show Modal
  </.button_primary>
  <.modal
    id="example-modal"
    header_text="Modal header"
    cancel_event_name="cancelled_modal"
    accept_event_name="accepted_modal"
    cancel_button_text="Reset"
    accept_button_text="Apply"
  >
    Lorem Ipsum is simply dummy text of the printing and typesetting industry.
    Lorem Ipsum has been the industry's standard dummy text ever since the 1500s,
    when an unknown printer took a galley of type and scrambled it to make a type specimen book.
    It has survived not only five centuries, but also the leap into electronic typesetting,
    remaining essentially unchanged. It was popularised in the 1960s with the release of Letraset
    sheets containing Lorem Ipsum passages, and more recently with desktop publishing software
    like Aldus PageMaker including versions of Lorem Ipsum.
  </.modal>

  <.h2>Filter Modal</.h2>

  <.form for={@flop_form} class="form-control">
    <.filter_modal form={@flop_form} filter_count={2} />
  </.form>

  <.h2>Buttons</.h2>

  <div class="inline-grid gap-4 grid-cols-1 mb-8">
    <.button_primary>Primary Button</.button_primary>
    <.button_primary disabled={true}>Primary Button (disabled)</.button_primary>
    <.button_secondary>Secondary Button</.button_secondary>
    <.button_secondary disabled={true}>Secondary Button (disabled)</.button_secondary>
    <.button_danger>Danger Button</.button_danger>
    <.button_danger disabled={true}>Danger Button (disabled)</.button_danger>
    <.button_toggle>Toggle Button (active)</.button_toggle>
    <.button_toggle use_outline_buttons={true}>Toggle Button (w/outline, active)</.button_toggle>
    <.button_toggle active={false}>Toggle Button (inactive)</.button_toggle>
    <.button_toggle use_outline_buttons={true} active={false}>
      Toggle Button (w/outline, inactive)
    </.button_toggle>
    <.button_toggle icon="Red Line">Toggle Button with Icon</.button_toggle>
    <.button_toggle disabled={true}>Toggle Button (disabled)</.button_toggle>
    <.radio_switch name="my_radio" selected="radio" values={["radio", "switch", "component"]} />
    <br />
  </div>

  <.h2>Form Fields</.h2>

  <.form for={@form} class="form-control gap-4" phx-change="rerender">
    <.select
      label="Select"
      field={@form[:single_select]}
      options={single_select_options()}
      prompt="All"
      class="max-w-[16rem] mb-8"
    />
    <.select
      label="Disabled Select"
      field={@form[:single_select_disabled]}
      options={single_select_options()}
      prompt="All"
      disabled={true}
      class="max-w-[16rem] mb-8"
    />
    <.select
      label="Warning Select"
      field={@form[:single_select]}
      options={single_select_options()}
      prompt="All"
      class="max-w-[16rem] mb-8"
      warning={true}
    />
    <.select
      label="Errored Select"
      field={@form[:single_select_error]}
      options={single_select_options()}
      prompt="All"
      class="max-w-[16rem] mb-8"
    />

    <.modal
      id="filter-modal"
      header_text="Filter by word length"
      cancel_event_name="ignore"
      accept_event_name="ignore"
      accept_button_text="Apply"
    >
      <.filtered_select
        label="Length"
        multiple={false}
        field={@form[:modal_filter]}
        filter_field={@form[:modal_filter_filter]}
        options={
          filtered_select_options(@form[:modal_filter_filter].value, single_select_options())
        }
        prompt="All"
        class="h-[35rem]"
      />
    </.modal>

    <.filtered_select
      label="filtered_select"
      modal_filter_id="filter-modal"
      modal_filter_title={"Filter: #{@form[:modal_filter].value}"}
      field={@form[:filtered_select]}
      filter_field={@form[:filtered_select_filter]}
      options={
        filtered_select_options(@form[:filtered_select_filter].value, select_options())
        |> Enum.filter(fn {key, _value} ->
          cond do
            @modal_filter_value == "default" -> true
            String.length(key) === String.to_integer(@modal_filter_value) -> true
            true -> false
          end
        end)
      }
      class="max-w-[16rem] mb-[4rem] min-h-[12rem]"
    />
    <.filtered_select
      label="Disabled filtered_select"
      field={@form[:filtered_select_disabled]}
      filter_field={@form[:filtered_select_filter_disabled]}
      options={filtered_select_options(@form[:filtered_select_filter].value, select_options())}
      disabled={true}
      class="max-w-[16rem] mb-8 mb-[4rem] min-h-[12rem]"
    />
    <.filtered_select
      label="Errored filtered_select"
      field={@form[:filtered_select_error]}
      filter_field={@form[:filtered_select_filter_error]}
      options={filtered_select_options(@form[:filtered_select_filter].value, select_options())}
      prompt="All"
      disabled={true}
      class="max-w-[16rem] mb-8 mb-[4rem] min-h-[12rem]"
    />
    <.text_input
      label="Text Input"
      field={@form[:text_input]}
      placeholder="Text Input"
      class="mb-8"
    />
    <.text_input
      label="Disabled Text Input"
      field={@form[:text_input_disabled]}
      placeholder="Disabled Text Input"
      disabled={true}
      class="mb-8"
    />
    <.text_input
      label="Errored Text Input"
      field={@form[:text_input_error]}
      placeholder="Errored Text Input"
      class="mb-8"
    />
    <.textarea label="TextArea" field={@form[:textarea]} placeholder="TextArea" class="mb-8" />
    <.textarea
      label="Disabled TextArea"
      field={@form[:textarea_disabled]}
      placeholder="Disabled TextArea"
      disabled={true}
      class="mb-8"
    />
    <.textarea
      label="Errored TextArea"
      field={@form[:textarea_error]}
      placeholder="Errored TextArea"
      class="mb-8"
    />
    <div class="flex flex-col w-[16rem]">
      <.textarea
        field={@form[:textarea_footer]}
        label="Text Area with Counter"
        phx-debounce={120}
        maxlength="20"
        value={@form[:textarea_footer].value}
        class="min-w-[16rem]"
      />
      <.textarea_footer character_limit={20} field={@form[:textarea_footer]} />
    </div>
    <.toggle_checkgroup
      label="Checkgroup with icons"
      field={@form[:toggle_checkgroup]}
      options={single_select_options()}
      class="max-w-[16rem] flex-col"
      show_icons={true}
    />

    <.datetime
      field={@form[:datetime]}
      min={@current_time}
      value={@current_time}
      label="Datetime"
      class="md:min-w-64 md:max-w-64"
    />
    <.datetime
      field={@form[:datetime_disabled]}
      min={@current_time}
      value={@current_time}
      label="Disabled Datetime"
      class="md:min-w-64 md:max-w-64"
      disabled={true}
    />
    <.form_checkbox label="Checkbox" field={@form[:checkbox]} />
    <.form_checkbox
      label="Different checkbox"
      field={@form[:checkbox_icon]}
      class="h-5 w-5"
      check_class="w-[100%] h-[100%] checked:before:hero-truck leading-normal checked:before:mb-8"
    />
  </.form>

  <div class="mt-16">
    <.checkbox
      id="normal-checkbox"
      name="anormal-checkbox"
      value="true"
      checked={true}
    />
    <AlertsUIWeb.SharedComponents.label for="normal-checkbox">
      A checkbox with no form field
    </AlertsUIWeb.SharedComponents.label>
  </div>
</div>
