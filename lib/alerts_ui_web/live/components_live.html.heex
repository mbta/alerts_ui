<div class="p-16">
  <.h1>Components Style Guide</.h1>

  <.h2>Colors</.h2>

  <.h3>Primitive Colors</.h3>

  <div class="inline-grid gap-4 grid-flow-col">
    <.color_block name="primary" value="#8ecdff" />
    <.color_block name="secondary" value="#171f26" />
    <.color_block name="success" value="#a7ffeb" />
    <.color_block name="danger" value="#dc3545" />
  </div>

  <.h3>Background Colors</.h3>

  <div class="inline-grid gap-4 grid-flow-col">
    <.color_block name="bg-primary" value="#0f1417" />
    <.color_block name="bg-secondary" value="#171f26" />
    <.color_block name="bg-elevation-3" value="#1e2933" />
    <.color_block name="bg-elevation-4" value="#2b3741" />
    <.color_block name="bg-elevation-5" value="#2e3f4d" />
    <.color_block name="bg-elevation-6" value="#384e5c" />
    <.color_block name="bg-input-default" value="#2e3f4d" />
  </div>

  <.h3>Border Colors</.h3>

  <div class="inline-grid gap-4 grid-flow-col">
    <.color_block name="border-primary" value="#8b9198" />
    <.color_block name="border-focus" value="#8ecdff" />
    <.color_block name="border-disabled" value="#c6c6c9" />
  </div>

  <.h3>Menu Colors</.h3>
  <div class="inline-grid gap-4 grid-flow-col">
    <.color_block name="menu-active" value="#c1e4ff" />
  </div>

  <.h3>Text Colors</.h3>

  <div class="inline-grid gap-4 grid-flow-col">
    <.color_block name="text-primary" value="#f8f9fa" />
    <.color_block name="text-secondary" value="#6c757d" />
    <.color_block name="text-disabled" value="#c6c6c9" />
    <.color_block name="text-link-outline" value="#8ecdff" />
    <.color_block name="text-error" value="#ffb4ab" />
    <.color_block name="text-invert" value="#212529" />
    <.color_block name="text-white" value="#ffffff" />
    <.color_block name="text-dark" value="#212529" />
  </div>

  <.h3>MBTA Service Colors</.h3>

  <div class="inline-grid gap-4 grid-rows-2 grid-cols-5">
    <.color_block name="mbta-commuter-rail" value="#80276c" />
    <.color_block name="mbta-subway" value="#494f5b" />
    <.color_block name="mbta-bus" value="#ffc72c" />
    <.color_block name="mbta-ferry" value="#008eaa" />
    <.color_block name="mbta-the ride" value="#52bbc5" />
    <.color_block name="mbta-red" value="#da291c" />
    <.color_block name="mbta-orange" value="#ed8b00" />
    <.color_block name="mbta-green" value="#00843d" />
    <.color_block name="mbta-blue" value="#003da5" />
    <.color_block name="mbta-silver" value="#6c777e" />
  </div>

  <.h2>Typography</.h2>

  <.h1>H1 Header</.h1>
  <.h2>H2 Header</.h2>
  <.h3>H3 Header</.h3>
  <.h4>H4 Header</.h4>
  <.h5>H5 Header</.h5>
  <.h6>H6 Header</.h6>

  <.p>
    Paragraph text. Lorem ipsum dolor sit amet, consectetur adipiscing elit. Cras consequat erat nec enim ultrices bibendum. Nulla fermentum felis in ultrices tincidunt. Donec luctus placerat neque, eu porta ante aliquam vitae. Cras consequat tristique vulputate. Morbi at erat neque. Suspendisse porttitor erat tellus, in sodales magna faucibus nec. Quisque dignissim enim id metus suscipit luctus. Nunc in cursus nibh, sed tincidunt mauris.
  </.p>

  <.h2>Buttons</.h2>

  <div class="inline-grid gap-4 grid-cols-1 mb-4">
    <.button_primary>Primary Button</.button_primary>
    <br />
    <.button_secondary>Secondary Button</.button_secondary>
    <br />
    <.button_toggle>Toggle Button (active)</.button_toggle>
    <.button_toggle icon="Red Line">Toggle Button with Icon</.button_toggle>
    <.button_toggle active={false}>Toggle Button (inactive)</.button_toggle>
  </div>

  <.h2>Form Fields</.h2>

  <.form for={@form} class="form-control gap-4" phx-change="rerender">
    <.select
      label="Select"
      field={@form[:single_select]}
      options={single_select_options()}
      prompt="All"
      class="max-w-[16rem]"
    />
    <.select
      label="Disabled Select"
      field={@form[:single_select]}
      options={single_select_options()}
      prompt="All"
      disabled={true}
      class="max-w-[16rem]"
    />
    <.select
      label="Errored Select"
      field={@form[:single_select_error]}
      options={single_select_options()}
      prompt="All"
      class="max-w-[16rem]"
    />
    <.filtered_select
      label="filtered_select"
      field={@form[:filtered_select]}
      filter_field={@form[:filtered_select_filter]}
      options={filtered_select_options(@form[:filtered_select_filter].value)}
      class="max-w-[16rem]"
    />
    <.filtered_select
      label="Disabled filtered_select"
      field={@form[:filtered_select]}
      filter_field={@form[:filtered_select_filter]}
      options={filtered_select_options(@form[:filtered_select_filter].value)}
      disabled={true}
      class="max-w-[16rem]"
    />
    <.filtered_select
      label="Errored filtered_select"
      field={@form[:filtered_select_error]}
      filter_field={@form[:filtered_select_filter]}
      options={filtered_select_options(@form[:filtered_select_filter].value)}
      prompt="All"
      disabled={true}
      class="max-w-[16rem]"
    />
    <.text_input label="Text Input" field={@form[:text_input]} placeholder="Text Input" />
    <.text_input
      label="Disabled Text Input"
      field={@form[:text_input]}
      placeholder="Disabled Text Input"
      disabled={true}
    />
    <.text_input
      label="Errored Text Input"
      field={@form[:text_input_error]}
      placeholder="Errored Text Input"
    />
    <.textarea label="TextArea" field={@form[:textarea]} placeholder="TextArea" />
    <.textarea
      label="Disabled TextArea"
      field={@form[:textarea]}
      placeholder="Disabled TextArea"
      disabled={true}
    />
    <.textarea
      label="Errored TextArea"
      field={@form[:textarea_error]}
      placeholder="Errored TextArea"
    />
    <.toggle_checkgroup
      label="Checkgroup with icons"
      field={@form[:toggle_checkgroup]}
      options={single_select_options()}
      class="max-w-[16rem]"
      show_icons={true}
    />
    <.datetime
      field={@form[:datetime]}
      min={@current_time}
      value={@current_time}
      label="Datetime"
      class="min-w-[16rem] max-w-[16rem]"
    />
    <.datetime
      field={@form[:datetime]}
      min={@current_time}
      value={@current_time}
      label="Disabled Datetime"
      class="min-w-[16rem] max-w-[16rem]"
      disabled={true}
    />
  </.form>
</div>
