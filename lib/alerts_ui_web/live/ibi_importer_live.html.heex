<div id="importer-delivery">
  <div id="upload">
    <h2 class="font-medium text-2xl">Generate an upload URL</h2>
    <p>
      Generates a URL you can use to upload the source file (use HTTP PUT):
    </p>
    <p>
      <.button phx-click="put">Make upload URL</.button>
    </p>
    <div id="importer-delivery-put-url">
      <pre>
        {Map.get(assigns, :put, "")}
      </pre>
    </div>
  </div>

  <div id="download">
    <h2 class="font-medium text-2xl">Generate a download URL</h2>
    <p>
      Generates a URL you can use to download the source file in case that's helpful:
    </p>
    <p>
      <.button phx-click="get">Make download URL</.button>
    </p>
    <div id="importer-delivery-get-url">
      <pre>
        <a href={Map.get(assigns, :get, "")}>
          {Map.get(assigns, :get, "")}
        </a>
      </pre>
    </div>
  </div>

  <div id="import">
    <h2 class="font-medium text-2xl">Start an import</h2>
    <p>
      Kick off an import run (import id will appear if successful so you can search the logs):
    </p>
    <p>
      <.button phx-click="import">Import</.button>
    </p>
    <div id="importer-delivery-import">
      <pre>
        {Map.get(assigns, :import_id, "")}
      </pre>
    </div>
    <div id="importer-delivery-error">
      {Map.get(assigns, :import_error, "")}
    </div>
  </div>

  <div id="wipe">
    <h2 class="font-medium text-2xl">Clear database</h2>
    <p>
      Wipe all alerts and IBI imports from this database:
    </p>
    <p>
      <.button class="bg-red-400" phx-click="wipe">DESTROY</.button>
    </p>
  </div>
</div>
