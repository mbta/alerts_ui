<div class="flex flex-col items-center justify-center min-w-full" id="form_container">
  <.live_component module={Timeline} id="timeline" progress={@progress} steps={@steps} />
  <div class="min-w-[100%] flex flex-col items-center justify-center ml-[15%]" id="article-view">
    <article class="min-w-[100%] flex flex-col items-center justify-center">
      <.live_component
        module={RouteTypeAndEffect}
        id="route_type"
        progress={@progress}
        alert_data={@alert_data}
      />
      <div :if={@progress.name == "details"} class="w-full">
        <.live_component
          module={choose_affected_service_component(@combination)}
          id="affected_service"
          progress={@progress}
          alert_data={@alert_data}
          combination={@combination}
          route_type={route_type(@alert_data)}
          effect_name={effect_name(@alert_data)}
          available_routes={@available_routes}
          available_schedules={@available_schedules}
          available_stops={@available_stops}
          available_facilities={@available_facilities}
          editing={@editing}
          submitted={@submitted}
        />
        <.live_component
          module={TimeRange}
          id="time_range"
          progress={@progress}
          alert_data={@alert_data}
          editing={@editing}
        />
        <.live_component
          module={AlertDetails}
          id="alert_details"
          progress={@progress}
          alert_data={@alert_data}
          route_type={route_type(@alert_data)}
          combination={@combination}
        />
        <.live_component
          module={Delivery}
          id="delivery"
          progress={@progress}
          alert_data={@alert_data}
          combination={@combination}
        />
        <.live_component
          module={RiderReminders}
          id="rider_reminders"
          progress={@progress}
          alert_data={@alert_data}
          editing={@editing}
        />
        <.live_component module={Submit} id="submit" progress={@progress} />
      </div>
      <.live_component
        :if={@progress.name == "success"}
        module={SuccessfulSubmission}
        id="successful_submission"
        progress={@progress}
        alert_uuid={@alert_uuid}
        show_created_alert={@show_created_alert}
      />
    </article>
    <.flash kind={:info} title="Success!" flash={@flash} />
    <.form_error_flash title="Please fix these issues:" flash={@flash} />
  </div>
</div>
