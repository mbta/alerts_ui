<div
  class="flex flex-col items-center justify-center"
  id="form_container"
  data-debug-tag={@debug_tag}
>
  <.live_component
    module={Timeline}
    id="timeline"
    progress={@progress}
    steps={@steps}
    form_type={@form_type}
    alert_id={@alert_id}
  />
  <div class="flex flex-col items-center justify-center w-[90%]" id="article-view">
    <article class="flex flex-col items-center justify-center w-[100%]">
      <.live_component
        :if={@progress.name == "route_type_and_effect"}
        module={RouteTypeAndEffect}
        id="route_type"
        progress={@progress}
        alert_data={@alert_data}
        selected_route_type={@selected_route_type}
      />
      <div :if={@progress.name == "details"} class="w-full">
        <.live_component
          module={choose_affected_service_component(@combination)}
          id="affected_service"
          progress={@progress}
          alert_data={@alert_data}
          combination={@combination}
          route_type={route_type(@alert_data)}
          effect_name={effect_name(@alert_data)}
          form_type={@form_type}
          submitted={@submitted}
          show_stop_ids={@show_stop_ids}
        />
        <.live_component
          module={TimeRange}
          id="time_range"
          progress={@progress}
          alert_data={@alert_data}
          form_type={@form_type}
          selected_schedules={@selected_schedules}
          remounted={@remounted}
        />
        <.live_component
          module={NotificationPeriod}
          id="notification_period"
          progress={@progress}
          alert_data={@alert_data}
          form_type={@form_type}
          remounted={@remounted}
        />
        <.live_component
          module={AlertDetails}
          id="alert_details"
          progress={@progress}
          alert_data={@alert_data}
          route_type={route_type(@alert_data)}
          combination={@combination}
          selected_facilities={@selected_facilities}
          selected_routes={@selected_routes}
          selected_stops={@selected_stops}
          selected_schedules={@selected_schedules}
          form_type={@form_type}
        />
        <.live_component
          module={Delivery}
          id="delivery"
          progress={@progress}
          alert_data={@alert_data}
          combination={@combination}
        />
        <.live_component
          module={RiderReminders}
          id="rider_reminders"
          progress={@progress}
          form_type={@form_type}
          active_period_end={Map.get(@alert_data, :active_period_end)}
          active_period_end_specifier={Map.get(@alert_data, :active_period_end_specifier)}
          active_period_start={Map.get(@alert_data, :active_period_start)}
          notification_period_end={Map.get(@alert_data, :notification_period_end)}
          notification_period_start={Map.get(@alert_data, :notification_period_start)}
          notification_specifier={Map.get(@alert_data, :notification_period_specifier)}
          reminder_times={Map.get(@alert_data, :reminder_times)}
        />
        <.live_component
          module={Submit}
          id="submit"
          back={@form_type == :creating}
          progress={@progress}
          alert_data={@alert_data}
          form_type={@form_type}
          alert_id={@alert_id}
          selected_routes={@selected_routes}
          selected_schedules={@selected_schedules}
          current_user={@current_user}
          return_to={@return_to}
          combination={@combination}
        />
        <.modal
          :if={!(Map.get(assigns, :obsolete_ids, nil) |> Enum.empty?())}
          id="gtfs-warning-modal"
          class="flex flex-col h-full justify-center w-[600px]"
          header_text=""
          accept_button_text="Continue"
          cancel_button_text="Cancel"
          cancel_event_name="cancelled_gtfs_modal"
          accept_event_name="accepted_gtfs_modal"
        >
          <:header>
            <.warning_icon class="inline text-warning" stroke="#2b3741" fill="currentColor" />
            Warning: Outdated entities will be omitted
          </:header>
          This alert includes 1+ affected entities that no longer exist in GTFS or are no longer
          associated to the original selections. These entities will be omitted and will not be
          published in this alert. <br />
          <br />
          <ul class="list-disc ml-8">
            <div :for={{title, names} <- @obsolete_id_text}>
              <li class="font-semibold">{title}:</li>
              <ul class="list-[circle] ml-8">
                <li :for={name <- names}>{name}</li>
              </ul>
            </div>
          </ul>
        </.modal>
      </div>
    </article>
  </div>
</div>
