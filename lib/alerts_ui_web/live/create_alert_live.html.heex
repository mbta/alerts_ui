<div class="flex flex-col items-center justify-center" id="form_container">
  <.live_component
    module={Timeline}
    id="timeline"
    progress={@progress}
    steps={@steps}
    editing={@editing}
  />
  <div class="flex flex-col items-center justify-center w-[90%]" id="article-view">
    <article class="flex flex-col items-center justify-center w-[100%]">
      <.live_component
        :if={@progress.name == "route_type_and_effect"}
        module={RouteTypeAndEffect}
        id="route_type"
        progress={@progress}
        alert_data={@alert_data}
      />
      <div :if={@progress.name == "details"} class="w-full">
        <.live_component
          module={choose_affected_service_component(@combination)}
          id="affected_service"
          progress={@progress}
          alert_data={@alert_data}
          combination={@combination}
          route_type={route_type(@alert_data)}
          effect_name={effect_name(@alert_data)}
          available_facilities={@available_facilities}
          editing={@editing}
          submitted={@submitted}
        />
        <.live_component
          module={TimeRange}
          id="time_range"
          progress={@progress}
          alert_data={@alert_data}
          editing={@editing}
          selected_schedules={@selected_schedules}
        />
        <.live_component
          module={NotificationPeriod}
          id="notification_period"
          progress={@progress}
          alert_data={@alert_data}
          editing={@editing}
        />
        <.live_component
          module={AlertDetails}
          id="alert_details"
          progress={@progress}
          alert_data={@alert_data}
          route_type={route_type(@alert_data)}
          combination={@combination}
          selected_facility={@selected_facility}
          selected_routes={@selected_routes}
          selected_stops={@selected_stops}
          selected_schedules={@selected_schedules}
        />
        <.live_component
          module={Delivery}
          id="delivery"
          progress={@progress}
          alert_data={@alert_data}
          combination={@combination}
        />
        <.live_component
          module={RiderReminders}
          id="rider_reminders"
          progress={@progress}
          alert_data={@alert_data}
          editing={@editing}
        />
        <.live_component
          module={Submit}
          id="submit"
          progress={@progress}
          alert_data={@alert_data}
          editing={@editing}
          alert_id={@alert_id}
          selected_schedules={@selected_schedules}
        />
      </div>
    </article>
    <.form_error_flash title="Please fix these issues:" flash={@flash} id="error-flash" />
  </div>
</div>
