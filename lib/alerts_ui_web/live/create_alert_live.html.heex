<div class="flex flex-col items-center justify-center min-w-full">
  <.live_component module={Timeline} id="timeline" progress={@progress} steps={@steps} />
  <div
    class={
      if compare_feed(),
        do: "hidden",
        else: "min-w-[75%] flex flex-col items-center justify-center"
    }
    id="article-view"
  >
    <article class="prose prose-stone min-w-full flex flex-col items-center justify-center">
      <.live_component module={RouteTypeAndEffect} id="route_type" progress={@progress} />

      <.live_component
        module={AffectedService}
        id="details"
        progress={@progress}
        alert_data={@alert_data}
        route_type={route_type(@alert_data)}
        available_routes={@available_routes}
        available_stops={@available_stops}
      />
      <.live_component module={AlertDetails} id="details" progress={@progress} />

      <.live_component module={SuccessfulSubmission} id="success" progress={@progress} />
    </article>
    <.flash kind={:info} title="Success!" flash={@flash} />
    <.flash kind={:error} title="Error creating Alert!" flash={@flash} />
  </div>
  <div class={
    if compare_feed(),
      do:
        "alert alert-error w-[50%] h-24 font-extrabold flex flex-col items-center justify-center",
      else: "hidden"
  }>
    ! Please do not create Alerts on this server !
  </div>
</div>
