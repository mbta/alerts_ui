<div class="flex flex-col items-center justify-center" id="form_container">
  <TimelineSlice.render
    form={@form}
    previous_steps={@previous_steps}
    progress={@progress}
    steps={@steps}
    form_type={@form_type}
    alert_id={@alert_id}
    change_type={@change_type}
  />
  <div class="flex flex-col items-center justify-center w-[90%]" id="article-view">
    <article class="flex flex-col items-center justify-center w-[100%]">
      <div class="w-full">
        <UrlSlice.render
          :if={!AlertDataHelpers.show_details?(@form, @change_type)}
          alert_id={@alert_id}
          path_route_type={@path_route_type}
          path_effect_name={@path_effect_name}
          change_type={@change_type}
        />
        <.form
          :if={AlertDataHelpers.show_details?(@form, @change_type)}
          for={@form}
          id="alert_form"
          class="form-control flex flex-row flex-wrap mb-4 min-h-[38rem] md:min-h-[32rem] group"
          phx-no-unused-field
          phx-change="validate"
          phx-auto-recover="recover_form"
        >
          <Title.render
            route_type_name={AlertDataHelpers.humanize_route_type(@form)}
            effect_name={AlertDataHelpers.humanize_effect_name(@form)}
            icon_name=""
          />
          <AlertsUIWeb.CreateAlertLive.rendered_service_slice
            form={@form}
            selections={@selections}
            show_stop_ids={@show_stop_ids}
            first_async_load={@first_async_load}
            skate_detours={@skate_detours}
            used_detours={@used_detours}
            show_new_bus_detours={@show_new_bus_detours}
          />
          <TimeRangeSlice.render
            form={@form}
            current_time={@current_time}
            trip_arrival_time={@trip_arrival_time}
            previous_start_specifier={@previous_start_specifier}
            previous_end_specifier={@previous_end_specifier}
            previous_start_time_specifier={@previous_start_time_specifier}
            previous_end_time_specifier={@previous_end_time_specifier}
            skate_detours={@skate_detours}
          />
          <NotificationPeriodSlice.render
            form={@form}
            current_time={@current_time}
            form_type={@form_type}
          />
          <AlertDetailsSlice.render
            form={@form}
            severity_options={@severity_options}
            cause_options={@cause_options}
            image_size={@image_size}
            image_path={@image_path}
            selections={@selections}
            skate_detours={@skate_detours}
          />
          <DeliverySlice.render form={@form} />
          <ReminderTimesSlice.render form={@form} />
          <SubmitSlice.render
            form={@form}
            progress={@progress}
            current_user={@current_user}
            return_to={@return_to}
            selections={@selections}
            form_type={@form_type}
            show={@show}
            image_preview_size={@image_preview_size}
            check_predictions={@check_predictions}
            check_trip_end={@check_trip_end}
            persisting_alert={@persisting_alert}
          />
          <.modal
            :if={@modal_open_map[@gtfs_modal_id]}
            id={@gtfs_modal_id}
            class="flex flex-col h-full justify-center w-[600px]"
            header_text=""
            accept_button_text="Continue"
            cancel_button_text="Cancel"
            cancel_event_name="cancelled_gtfs_modal"
            accept_event_name="accepted_gtfs_modal"
          >
            <:header>
              <.warning_icon class="inline text-warning" stroke="#2b3741" fill="currentColor" />
              Warning: Outdated entities will be omitted
            </:header>
            This alert includes 1+ affected entities that no longer exist in GTFS or are no longer
            associated to the original selections. These entities will be omitted and will not be
            published in this alert. <br />
            <br />
            <ul class="list-disc ml-8">
              <div :for={{title, names} <- @obsolete_id_text}>
                <li class="font-semibold">{title}:</li>
                <ul class="list-[circle] ml-8">
                  <li :for={name <- names}>{name}</li>
                </ul>
              </div>
            </ul>
          </.modal>
        </.form>
        <.modal
          :if={@modal_open_map[@change_mode_effect_modal_id]}
          id={@change_mode_effect_modal_id}
          class="flex flex-col h-full justify-center w-[600px]"
          header_text=""
          accept_button_text="Continue"
          cancel_button_text="Cancel"
          cancel_event_name="cancelled_change_mode_effect_modal"
          accept_event_name="accepted_change_mode_effect_modal"
        >
          <:header>
            <.warning_icon class="inline text-warning" stroke="#2b3741" fill="currentColor" />
            Warning: Affected service selections may be omitted
          </:header>
          Because you are changing the mode and/or effect of this alert,
          some affected services may be omitted. Do you still want to continue?
        </.modal>
      </div>
    </article>
  </div>
</div>
