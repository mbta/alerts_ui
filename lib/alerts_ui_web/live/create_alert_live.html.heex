<div class="flex flex-col items-center justify-center min-w-full">
  <.live_component module={Timeline} id="timeline" progress={@progress} steps={@steps} />
  <div class="min-w-[75%] flex flex-col items-center justify-center" id="article-view">
    <article class="min-w-full flex flex-col items-center justify-center px-4">
      <.live_component
        module={RouteTypeAndEffect}
        id="route_type"
        progress={@progress}
        alert_data={@alert_data}
      />

      <.live_component
        :if={@combination != nil}
        module={if @combination === :SR, do: StopRouteAffectedService, else: AffectedService}
        id="affected_service"
        progress={@progress}
        alert_data={@alert_data}
        combination={@combination}
        route_type={route_type(@alert_data)}
        available_routes={@available_routes}
        available_schedules={@available_schedules}
        available_stops={@available_stops}
        editing={@editing}
      />
      <.live_component
        :if={@combination == nil and @is_facility_alert}
        module={FacilityAffectedService}
        id="facility-affected-service"
        progress={@progress}
        alert_data={@alert_data}
        editing={@editing}
      />
      <.live_component
        :if={@combination == nil and !@is_facility_alert}
        module={SystemwideAffectedService}
        id="systemwide-affected-service"
        progress={@progress}
        alert_data={@alert_data}
        editing={@editing}
      />
      <.live_component
        module={TimeRange}
        id="time_range"
        progress={@progress}
        alert_data={@alert_data}
        editing={@editing}
      />
      <.live_component
        module={AlertDetails}
        id="details"
        progress={@progress}
        alert_data={@alert_data}
        route_type={route_type(@alert_data)}
        is_facility_alert={@is_facility_alert}
      />

      <.live_component
        module={SuccessfulSubmission}
        id="success"
        progress={@progress}
        alert_uuid={@alert_uuid}
        show_created_alert={@show_created_alert}
      />
    </article>
    <.flash kind={:info} title="Success!" flash={@flash} />
    <.flash kind={:error} title="Error creating Alert!" flash={@flash} />
  </div>
</div>
