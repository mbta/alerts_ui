<div class="flex flex-col items-center justify-center" id="form_container">
  <.live_component
    module={Timeline}
    id="timeline"
    progress={@progress}
    steps={@steps}
    editing={@editing}
  />
  <div class="flex flex-col items-center justify-center w-[90%]" id="article-view">
    <article class="flex flex-col items-center justify-center w-[100%]">
      <.live_component module={RouteTypeAndEffect} id="route_type" progress={@progress} />
      <div :if={@progress.name == "details"} class="w-full">
        <.live_component
          module={choose_affected_service_component(@combination)}
          id="affected_service"
          progress={@progress}
          combination={@combination}
          route_type={@route_type}
          effect_name={@effect_name}
          submitted={@submitted}
          facility_id={@facility_id}
          route_ids={@route_ids}
          stop_ids={@stop_ids}
          trip_ids={@trip_ids}
          direction={@direction}
        />
        <.live_component
          module={TimeRange}
          id="time_range"
          progress={@progress}
          selected_trips={@selected_trips}
          active_period_data={@active_period_data}
          editing={@editing}
        />
        <.live_component
          module={NotificationPeriod}
          notification_period_start={@notification_period_start}
          notification_specifier={@notification_specifier}
          active_period_data={@active_period_data}
          id="notification_period"
          progress={@progress}
        />
        <.live_component
          module={AlertDetails}
          id="alert_details"
          progress={@progress}
          route_type={@route_type}
          combination={@combination}
          header_text={@header_text}
          description_text={@description_text}
          cause_detail={@cause_detail}
          url={@url}
          image_url={@image_url}
          image_alternative_text={@image_alternative_text}
          severity={@severity}
        />
        <.live_component
          module={Delivery}
          id="delivery"
          progress={@progress}
          combination={@combination}
          banner_text={@banner_text}
          header_text={@header_text}
          view_banner={@view_banner}
          banner_sync_toggle={@banner_sync_toggle}
        />
        <.live_component
          module={RiderReminders}
          id="rider_reminders"
          progress={@progress}
          editing={@editing}
          reminder_times={@reminder_times}
          notification_period_start={@notification_period_start}
          active_period_start={{Map.get(@active_period_data, :active_period_start)}}
          active_period_end_specifier={Map.get(@active_period_data, :active_period_end_specifier)}
          active_period_end={Map.get(@active_period_data, :active_period_end)}
        />
        <.live_component module={Submit} id="submit" progress={@progress} />
      </div>
      <.live_component
        :if={@progress.name == "success"}
        module={SuccessfulSubmission}
        id="successful_submission"
        progress={@progress}
        alert_uuid={@alert_uuid}
        show_created_alert={@show_created_alert}
      />
    </article>
    <.flash kind={:info} title="Success!" flash={@flash} id="success-flash" />
    <.form_error_flash title="Please fix these issues:" flash={@flash} id="error-flash" />
  </div>
</div>
