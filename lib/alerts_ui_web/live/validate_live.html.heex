<div class="prose prose-stone max-w-full w-full p-8">
  <h1>Validate Alert Feeds</h1>

  <div class="grid grid-cols-2 gap-x-4">
    <div>
      <h2>Feed: IBI</h2>

      <.search_form value={@ibi_alert_id} name="ibi_alert_id" label="Alert ID" />
    </div>

    <div>
      <h2>Feed: Dev Orange</h2>

      <.search_form value={@dev_orange_alert_id} name="dev_orange_alert_id" label="Alert ID" />
    </div>
  </div>

  <div :if={@comparison} class="grid grid-cols-1">
    <h2>Comparison</h2>

    <pre>
      <%= pretty_print(@comparison) %>
    </pre>
  </div>

  <div class="grid grid-cols-2 gap-x-4">
    <div>
      <%= if is_nil(@ibi_alert_data) do %>
        <pre>
          <%= @ibi_json %>
        </pre>
      <% else %>
        <pre>
          <%= pretty_print(@ibi_alert_data) %>
        </pre>
      <% end %>
    </div>

    <div>
      <%= if is_nil(@dev_orange_alert_data) do %>
        <pre>
          <%= @dev_orange_json %>
        </pre>
      <% else %>
        <pre>
          <%= pretty_print(@dev_orange_alert_data) %>
        </pre>
      <% end %>
    </div>
  </div>
</div>
