<div class="flex flex-col items-center justify-center" id="form_container">
  <div class="flex flex-col items-center justify-center w-[90%]" id="article-view">
    <article class="flex flex-col items-center justify-center w-[90%]">
      <div class="w-full">
        <TimelineSlice.render
          alert_id={@alert_id}
          form={@form}
          previous_steps={@previous_steps}
          progress={@progress}
          steps={@steps}
          form_type={@form_type}
        />
        <UrlSlice.render
          :if={!show_details?(@form)}
          alert_id={@alert_id}
          path_route_type={@path_route_type}
          path_effect_name={@path_effect_name}
        />
        <.form
          :if={show_details?(@form)}
          for={@form}
          id="alert_form"
          class="form-control flex flex-row flex-wrap mb-4 min-h-[38rem] md:min-h-[32rem]"
          phx-change="validate"
        >
          <Title.render
            route_type_name={humanize_route_type(@form)}
            effect_name={humanize_effect_name(@form)}
          />
          <ServiceSliceDispatcher.render form={@form} selections={@selections} />
          <AlertDetailsSlice.render
            form={@form}
            severity_options={@severity_options}
            cause_options={@cause_options}
            image_size={@image_size}
            image_path={@image_path}
            selections={@selections}
          />
          <ReminderTimesSlice.render form={@form} />
          <DeliverySlice.render form={@form} />
        </.form>
        <SubmitSlice.render
          back={@back}
          form={@form}
          progress={@progress}
          current_user={@current_user}
          return_to={@return_to}
          selections={@selections}
          form_type={@form_type}
          show={@show}
        />
      </div>
    </article>
  </div>
</div>
