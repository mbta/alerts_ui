<div id="view_alerts_live_view" class="h-[calc(100%-4rem)] mt-10 mb-6 mx-6 flex flex-col">
  <div class="flex justify-between">
    <.button_primary_link :if={Helpers.is_author?(@current_user)} href="/alerts/new" class="whitespace-nowrap">
      <.icon name="hero-plus" class="w-6 h-6 mr-1" />
      <span class="font-medium">
        Create new alert
      </span>
    </.button_primary_link>
    <.filter_form form={@form} filter_count={@filter_count} />
  </div>

  <div class="flex items-center bg-bg-secondary p-2 text-sm border-t border-border-primary justify-between">
    <span class="w-[100px]">
      {@meta.total_count} {BuildAutoText.maybe_pluralize("alert", @meta.total_count != 1)}
    </span>
    <.pagination meta={@meta} />
    <span class="w-[100px]" />
  </div>

  <div
    class="h-full shrink overflow-y-auto overflow-x-hidden"
    phx-hook="ScrollToTop"
    data-scroll-to-top={inspect(@scroll_to_top)}
    data-showing-alert-id={Map.get(assigns, :selected_alert_id, "")}
    id="alerts-table-container"
  >
    <Flop.Phoenix.table
      items={@alerts}
      meta={@meta}
      on_sort={JS.push("sort-alerts")}
      opts={[
        no_results_content: "No alerts found",
        symbol_asc: sort_icon(:asc),
        symbol_desc: sort_icon(:desc),
        symbol_unsorted: sort_icon(nil),
        table_attrs: [class: "table table-fixed min-w-[870px]"],
        tbody_td_attrs: [class: "px-2 py-1 leading-[1.5] break-words"],
        tbody_tr_attrs: [
          class: "hover:bg-bg-elevation-3 cursor-pointer odd:bg-bg-secondary border-none"
        ],
        thead_th_attrs: [class: "bg-bg-primary sticky top-0 z-10 px-2 leading-[1.5]"],
        thead_tr_attrs: [class: "text-base text-text-primary border-none"]
      ]}
      row_click={&JS.push("open_details", value: %{alert_id: &1.alert_id})}
    >
      <:col :let={alert} label="Service" field={:alert_id} col_style="width: 12.6%;">
        <.service_pills
          entities={Alert.get_original_ids(alert.original_route_selections)}
          effect_name={alert.effect_name}
        />
      </:col>
      <:col :let={alert} label="Effect" field={:effect_name} col_style="width: 8.6%;">
        {alert.effect_name}
      </:col>
      <:col
        :let={alert}
        label="ID"
        field={:integer_alert_id}
        col_style="width: 5.7%;"
        tbody_td_attrs={[class: "p-1 alert-id-cell"]}
      >
        {alert.alert_id}
      </:col>
      <:col :let={alert} label="Main Message" field={:header_text}>
        {alert.header_text}
      </:col>
      <:col
        :let={alert}
        label="Start"
        field={:active_period_start}
        directions={{:asc_nulls_first, :desc_nulls_last}}
        col_style="width: 7.5%;"
      >
        <div title={format_timestamp(alert.active_period_start)}>
          {format_start_time(alert.active_period_start)}
        </div>
      </:col>
      <:col
        :let={alert}
        label="End"
        field={
          if timeline_filter_past?(@params),
            do: :active_period_end,
            else: :notification_period_end
        }
        directions={{:asc_nulls_first, :desc_nulls_last}}
        col_style="width: 11%;"
        tbody_td_attrs={[class: "p-1 whitespace-nowrap"]}
      >
        <div
          title={format_timestamp(alert.active_period_end)}
          class={
            danger_text(
              alert.active_period_end,
              alert.closed_timestamp
            )
          }
        >
          {format_end_time(alert.active_period_end, alert.duration_certainty)}
        </div>
      </:col>
      <:action :let={alert} label="Actions" col_style="width: 128px">
        <div class="inline-flex justify-end space-x-2 w-full">
          <.button_secondary_link
            :if={!AlertsUIWeb.FormComponents.Helpers.Helpers.alert_is_closed(alert) && Helpers.is_author?(@current_user)}
            id={"edit-button-#{alert.alert_id}"}
            href={~p"/alerts/edit?alert_id=#{alert.alert_id}"}
            class="inline-flex rounded !px-2 !py-[3px]"
          >
            <.icon name="hero-pencil-solid" class="w-4 h-4" />
          </.button_secondary_link>
          <.button_secondary_link
            :if={!AlertsUIWeb.FormComponents.Helpers.Helpers.alert_is_closed(alert) && Helpers.is_author?(@current_user)}
            id={"close-button-#{alert.alert_id}"}
            class="inline-flex rounded !px-2 !py-[3px]"
            phx-click={
              JS.push("opening_close_modal",
                value: %{send_all_clear?: !is_nil(alert.last_push_notification_timestamp)}
              )
              |> show_modal("close-alert-modal-#{alert.alert_id}")
            }
          >
            <.icon name="hero-x-mark-solid" class="w-4 h-4" />
          </.button_secondary_link>
          <.button_menu id={"button-menu-#{alert.alert_id}"} container_id="view_alerts_live_view">
            <:toggle>
              <.button_secondary class="inline-flex rounded !px-2 !py-[3px]">
                <.icon name="hero-ellipsis-vertical" class="w-4 h-4" />
              </.button_secondary>
            </:toggle>
            <:menu>
              <.link
                :if={Helpers.is_author?(@current_user)}
                id={"duplicate-button-#{alert.alert_id}"}
                href={~p"/alerts/duplicate?alert_id=#{alert.alert_id}"}
                class="inline-flex items-center gap-1 leading-6 w-full px-2 autofocus hover:bg-bg-elevation-4"
              >
                <.icon name="hero-square-2-stack-solid" class="w-3 h-3" />
                <div>Duplicate</div>
              </.link>
              <.link
                class="inline-flex items-center gap-1 leading-6 w-full px-2 whitespace-nowrap hover:bg-bg-elevation-4"
                href={~p"/download_history?alert_id=#{alert.alert_id}"}
                target="_blank"
              >
                <.icon name="hero-document-arrow-down-solid" class="w-3 h-3" />
                <div>Download history</div>
              </.link>
            </:menu>
          </.button_menu>
          <AlertsUIWeb.ReviewModal.confirm_close_modal
            alert_id={alert.alert_id}
            send_all_clear?={@send_all_clear?}
          />
        </div>
      </:action>
    </Flop.Phoenix.table>
  </div>

  <AlertsUIWeb.ReviewModal.review_modal
    :if={Map.get(assigns, :selected_alert_data, nil)}
    alert_data={@selected_alert_data}
    alert_id={@selected_alert_id}
    send_all_clear?={@send_all_clear?}
    cancel_alert={true}
    cancel_event_name="close_details"
    target_id="#view_alerts_live_view"
    current_user={@current_user}
  />
</div>
