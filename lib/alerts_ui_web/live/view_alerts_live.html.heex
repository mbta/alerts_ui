<div
  id="view_alerts_live_view"
  class="p-4 md:flex md:flex-col md:h-full md:overflow-hidden"
>
  <div class="flex flex-col gap-4 lg:flex-row lg:justify-between">
    <.button_primary_link
      :if={UserHelpers.author?(@current_user)}
      href={form_path_new()}
      class="whitespace-nowrap"
    >
      <.icon name="hero-plus" class="w-6 h-6 mr-1" />
      <span class="font-medium">
        Create new alert
      </span>
    </.button_primary_link>
    <.filter_form form={@form} filter_count={@filter_count} />
  </div>

  <div class="sticky top-0 z-20 flex items-center bg-bg-secondary p-2 text-sm border-t border-border-primary justify-between min-h-[2.5rem]">
    <span class="w-24">
      <.loading loading={@loading}></.loading>
      <span :if={!@loading}>
        {@meta.total_count} {BuildAutoText.maybe_pluralize("alert", @meta.total_count != 1)}
      </span>
    </span>
    <.pagination meta={@meta} />
    <span class="w-24" />
  </div>

  <div
    class="overflow-x-auto min-h-48 md:h-full md:overflow-auto"
    phx-hook="ScrollToTop"
    data-scroll-to-top={inspect(@scroll_to_top)}
    data-showing-alert-id={Map.get(assigns, :selected_alert_id, "")}
    id="alerts-table-container"
  >
    <Flop.Phoenix.table
      :if={!@loading}
      items={@alerts}
      meta={@meta}
      on_sort={JS.push("paginate_start") |> JS.push("sort-alerts")}
      opts={[
        no_results_content: "No alerts found",
        symbol_asc: sort_icon(:asc),
        symbol_desc: sort_icon(:desc),
        symbol_unsorted: sort_icon(nil),
        table_attrs: [class: "table table-fixed min-w-[54rem]"],
        tbody_td_attrs: [class: "px-2 py-1 leading-[1.5] break-words"],
        tbody_tr_attrs: [
          class: "hover:bg-bg-elevation-3 cursor-pointer odd:bg-bg-secondary border-none"
        ],
        thead_th_attrs: [class: "bg-bg-primary px-2 leading-[1.5]"],
        thead_tr_attrs: [
          class: "md:sticky md:top-0 z-10 text-base text-text-primary border-none"
        ]
      ]}
      row_click={&JS.push("open_details", value: %{alert_id: &1.alert_id})}
    >
      <:col :let={alert} label="Service" field={:service_pill_sort_key} col_style="width: 12.6%;">
        <.service_pills
          entities={Alert.get_original_names_and_ids(alert.original_route_selections)}
          effect_name={alert.effect_name}
        />
      </:col>
      <:col :let={alert} label="Effect" field={:effect_name} col_style="width: 10%;">
        {alert.effect_name}
      </:col>
      <:col
        :let={alert}
        label="ID"
        field={:integer_alert_id}
        col_style="width: 5rem;"
        tbody_td_attrs={[class: "p-1 alert-id-cell"]}
      >
        {alert.alert_id}
      </:col>
      <:col :let={alert} label="Main Message" field={:header_text}>
        {alert.header_text}
      </:col>
      <:col
        :let={alert}
        label="Start"
        field={:active_period_start}
        directions={{:asc_nulls_first, :desc_nulls_last}}
        col_style="width: 7rem;"
        tbody_td_attrs={[class: "p-1 whitespace-nowrap"]}
      >
        <div title={safe_format_timestamp(alert.active_period_start)}>
          {safe_format_start_time(alert.active_period_start)}
        </div>
      </:col>
      <:col
        :let={alert}
        label="End"
        field={
          if timeline_filter_past?(@params),
            do: :active_period_end,
            else: :notification_period_end
        }
        directions={{:asc_nulls_first, :desc_nulls_last}}
        col_style="width: 7rem;"
        tbody_td_attrs={[class: "p-1 whitespace-nowrap"]}
      >
        <div
          title={
            safe_format_timestamp(alert.active_period_end, alert.duration_certainty, %{
              can_close_automatically: alert.can_close_automatically,
              primary_service_type: alert.primary_service_type,
              effect_name: alert.effect_name
            })
          }
          class={
            danger_text(
              alert.active_period_end,
              alert.closed_timestamp
            )
          }
        >
          {safe_format_end_time(
            alert.active_period_end,
            alert.duration_certainty,
            %{
              can_close_automatically: alert.can_close_automatically,
              primary_service_type: alert.primary_service_type,
              effect_name: alert.effect_name
            }
          )}
        </div>
      </:col>
      <:action :let={alert} label="Actions" col_style="width: 8rem;">
        <div class="inline-flex justify-end space-x-2 w-full">
          <.button_secondary_link
            :if={
              !alert_is_closed(alert) &&
                UserHelpers.author?(@current_user)
            }
            id={"edit-button-#{alert.alert_id}"}
            href={form_path_edit(alert.alert_id)}
            class="inline-flex rounded !px-2 !py-[3px]"
            title="Edit alert"
          >
            <.icon name="hero-pencil-solid" class="w-4 h-4" />
          </.button_secondary_link>
          <.button_secondary_link
            :if={
              !alert_is_closed(alert) &&
                UserHelpers.author?(@current_user)
            }
            id={"close-button-#{alert.alert_id}"}
            class="inline-flex rounded !px-2 !py-[3px]"
            title="Close alert"
            phx-click={
              JS.push("opening_close_modal",
                value: %{
                  send_all_clear?: !is_nil(alert.last_push_notification_timestamp),
                  alert_id: alert.alert_id
                }
              )
              |> show_modal("close-alert-modal-#{alert.alert_id}")
            }
          >
            <.icon name="hero-x-mark-solid" class="w-4 h-4" />
          </.button_secondary_link>
          <.button_menu id={"button-menu-#{alert.alert_id}"} container_id="view_alerts_live_view">
            <:toggle>
              <.button_secondary
                class="inline-flex rounded !px-2 !py-[3px]"
                title="Show more actions"
              >
                <.icon name="hero-ellipsis-vertical" class="w-4 h-4" />
              </.button_secondary>
            </:toggle>
            <:menu>
              <button
                id={"copy-link-button-#{alert.alert_id}"}
                class="inline-flex items-center gap-1 leading-6 w-full px-2 hover:bg-bg-elevation-4 cursor-pointer"
                phx-click={
                  JS.dispatch("phx:copy",
                    detail: %{text: @current_url <> "?alert_id=#{alert.alert_id}"}
                  )
                }
                aria-live="polite"
              >
                <span class="state-default">
                  <.icon name="hero-link-solid" class="w-3 h-3" /> Copy link
                </span>
                <span class="state-copied hidden" aria-hidden="true">
                  <.icon name="hero-check-solid" class="w-3 h-3" /> Copied
                </span>
              </button>
              <.link
                :if={UserHelpers.author?(@current_user)}
                id={"duplicate-button-#{alert.alert_id}"}
                href={form_path_duplicate(alert.alert_id)}
                class="inline-flex items-center gap-1 leading-6 w-full px-2 autofocus hover:bg-bg-elevation-4"
              >
                <.icon name="hero-square-2-stack-solid" class="w-3 h-3" />
                <div>Duplicate</div>
              </.link>
              <.link
                id={"download-history-button-#{alert.alert_id}"}
                class="inline-flex items-center gap-1 leading-6 w-full px-2 whitespace-nowrap hover:bg-bg-elevation-4"
                href={~p"/download_history/download?alert_id=#{alert.alert_id}"}
                target="_blank"
              >
                <.icon name="hero-document-arrow-down-solid" class="w-3 h-3" />
                <div>Download history</div>
              </.link>
            </:menu>
          </.button_menu>
          <AlertsUIWeb.ReviewModal.confirm_close_modal
            send_close_on_esc?={@current_close_modal == alert.alert_id}
            alert_id={alert.alert_id}
            send_all_clear?={!is_nil(alert.last_push_notification_timestamp)}
          />
        </div>
      </:action>
    </Flop.Phoenix.table>
  </div>

  <AlertsUIWeb.ReviewModal.review_modal
    :if={Map.get(assigns, :selected_alert_data, nil)}
    alert_data={@selected_alert_data}
    alert_id={@selected_alert_id}
    send_all_clear?={@send_all_clear?}
    cancel_alert={true}
    cancel_event_name="close_details"
    target_id="#view_alerts_live_view"
    current_user={@current_user}
    current_url={@current_url}
  />
</div>
