<div>
  <div data-theme="winter">
    <a href="/alerts/new" class="hover:text-zinc-700">
      Create an Alert
    </a>
      <.filter_form
        fields={[
          alert_id: [label: "ID", op: :ilike_and],
          effect_detail: [
            label: "Effect",
            type: "select",
            options: format_effect_options(),
            value: ""
          ],
          text_content: [label: "Keyword", op: :ilike_and],
          service_type: [
            label: "Service Type",
            type: "select",
            options: format_service_type_options()
          ],
          timeline: [
            label: "Timeline",
            type: "radio_switch",
            values: timeline_options()
          ]
        ]}
        meta={@meta}
        id="alert-filter-form"
      />
  </div>

  <AlertsUIWeb.ReviewModal.review_modal
    :if={Map.get(assigns, :selected_alert_data, nil)}
    alert_data={@selected_alert_data}
    alert_id={@selected_alert_id}
    cancel_alert={true}
    cancel_event_name="close_details"
    target_id="#view_alerts_live_view"
  />

  <div data-theme="winter">
    <Flop.Phoenix.table
      items={@alerts}
      meta={@meta}
      on_sort={JS.push("sort-alerts")}
      opts={[
        table_attrs: [class: "table"],
        tbody_tr_attrs: [class: "hover"],
        no_results_content: "No alerts found"
      ]}
      row_click={&JS.push("open_details", value: %{alert_id: &1.alert_id})}
    >
      <:col :let={alert} label="Service" field={:alert_id} col_style="min-width: 11rem;">
        <.service_pills
          entities={alert.original_route_selections}
          effect_name={alert.effect_name}
        />
      </:col>
      <:col :let={alert} label="Effect" field={:effect_detail} col_style="min-width: 7.5rem;">
        {format_effect(alert.effect_detail)}
      </:col>
      <:col :let={alert} label="ID" field={:integer_alert_id} col_style="min-width: 5rem;">
        {alert.alert_id}
      </:col>
      <:col :let={alert} label="Main Message" field={:header_text} col_style="min-width: 20rem;">
        {alert.header_text}
      </:col>
      <:col
        :let={alert}
        label="Start"
        field={:active_period_start}
        directions={{:asc_nulls_first, :desc_nulls_last}}
        col_style="min-width: 6.5rem;"
      >
        {format_start_time(alert.active_period_start)}
      </:col>
      <:col
        :let={alert}
        label="End"
        field={:active_period_end}
        directions={{:asc_nulls_first, :desc_nulls_last}}
        col_style="min-width: 6.5rem;"
      >
        <div class={
          if DateTimeHelpers.same_service_date?(alert.active_period_end), do: "text-danger"
        }>
          {format_end_time(alert.active_period_end, alert.duration_certainty)}
        </div>
      </:col>
      <:action :let={alert} label="Actions" col_style="min-width: 10rem;">
        <div class="inline-flex justify-end space-x-2 w-full">
          <.button_secondary_link
            :if={!AlertsUIWeb.FormComponents.Helpers.Helpers.alert_is_closed(alert)}
            href={~p"/alerts/edit?alert_id=#{alert.alert_id}"}
            class="inline-flex rounded-[4px] !px-2 !py-[3px]"
          >
            <.icon name="hero-pencil-solid" class="w-4 h-4" />
          </.button_secondary_link>
          <.button_secondary_link
            :if={!AlertsUIWeb.FormComponents.Helpers.Helpers.alert_is_closed(alert)}
            class="inline-flex rounded-[4px] !px-2 !py-[3px]"
          >
            <.icon name="hero-x-mark-solid" class="w-4 h-4" />
          </.button_secondary_link>
          <.button_menu>
            <:toggle>
              <.button_secondary class="inline-flex rounded-[4px] !px-2 !py-[3px]">
                <.icon name="hero-ellipsis-vertical" class="w-4 h-4" />
              </.button_secondary>
            </:toggle>
            <:menu>
              <.link class="inline-flex items-center gap-1 leading-6 w-full autofocus">
                <.icon name="hero-square-2-stack-solid" class="w-3 h-3" />
                <div>Duplicate</div>
              </.link>
              <.link class="inline-flex items-center gap-1 leading-6 w-full whitespace-nowrap">
                <.icon name="hero-document-arrow-down-solid" class="w-3 h-3" />
                <div>Download history (.csv)</div>
              </.link>
            </:menu>
          </.button_menu>
        </div>
      </:action>
    </Flop.Phoenix.table>

    <Flop.Phoenix.pagination
      meta={@meta}
      on_paginate={JS.push("paginate-alerts")}
      opts={[
        page_links: {:ellipsis, 3},
        wrapper_attrs: [class: "my-6 flex flex-row justify-center not-prose"],
        disabled_class: "join-item btn btn-disabled",
        pagination_link_attrs: [class: "join-item btn"],
        current_link_attrs: [class: "join-item btn btn-active"],
        next_link_content: "»",
        next_link_attrs: [class: "join-item btn btn-outline order-last ml-4"],
        previous_link_content: "«",
        previous_link_attrs: [class: "join-item btn btn-outline mr-4"],
        pagination_list_attrs: [class: "join"],
        ellipsis_attrs: [class: "join-item btn btn-disabled"]
      ]}
    />
  </div>
</div>
