<div class="my-20">
  <article>
    <.h1>Alerts</.h1>

    <div data-theme="winter">
      <.filter_form
        fields={[
          alert_id: [label: "ID", op: :ilike_and],
          effect_detail: [
            label: "Effect",
            type: "select",
            options: format_effect_options(),
            value: ""
          ],
          text_content: [label: "Keyword", op: :ilike_and],
          service_type: [
            label: "Service Type",
            type: "select",
            options: format_service_type_options()
          ],
          timeline: [
            label: "Timeline",
            type: "radio_switch",
            values: timeline_options()
          ]
        ]}
        meta={@meta}
        id="alert-filter-form"
      />
    </div>

    <div data-theme="winter">
      <Flop.Phoenix.table
        items={@alerts}
        meta={@meta}
        on_sort={JS.push("sort-alerts")}
        opts={[
          table_attrs: [class: "table"],
          tbody_tr_attrs: [class: "hover"],
          no_results_content: "No alerts found"
        ]}
      >
        <:col :let={alert} label="Service" field={:alert_id} col_style="min-width: 11rem;">
          <.service_pills
            entities={alert.original_route_selections}
            effect_name={alert.effect_name}
          />
        </:col>
        <:col :let={alert} label="Alert ID" field={:integer_alert_id}>{alert.alert_id}</:col>
        <:col :let={alert} label="Description" field={:header_text} col_style="min-width: 20rem;">
          {alert.header_text}
        </:col>
        <:col :let={alert} label="Created At" field={:created_at}>
          {DateTimeHelpers.friendly_date_time(alert.created_at)}
        </:col>
        <:col
          :let={alert}
          label="Start"
          field={:active_period_start}
          directions={{:asc_nulls_first, :desc_nulls_last}}
        >
          {format_start_time(alert.active_period_start)}
        </:col>
        <:col
          :let={alert}
          label="End"
          field={:active_period_end}
          directions={{:asc_nulls_first, :desc_nulls_last}}
        >
          <div class={if same_date?(alert.active_period_end), do: "text-danger"}>
            {format_end_time(alert.active_period_end, alert.duration_certainty)}
          </div>
        </:col>
        <:col :let={alert} label="Closed At" field={:closed_timestamp}>
          {DateTimeHelpers.friendly_date_time(alert.closed_timestamp)}
        </:col>
        <:col :let={alert}>
          <div class="badge badge-neutral badge-outline">
            <.link href={~p"/alerts/edit?alert_id=#{alert.alert_id}"}>edit</.link>
          </div>
        </:col>
      </Flop.Phoenix.table>

      <Flop.Phoenix.pagination
        meta={@meta}
        on_paginate={JS.push("paginate-alerts")}
        opts={[
          page_links: {:ellipsis, 3},
          wrapper_attrs: [class: "my-6 flex flex-row justify-center not-prose"],
          disabled_class: "join-item btn btn-disabled",
          pagination_link_attrs: [class: "join-item btn"],
          current_link_attrs: [class: "join-item btn btn-active"],
          next_link_content: "»",
          next_link_attrs: [class: "join-item btn btn-outline order-last ml-4"],
          previous_link_content: "«",
          previous_link_attrs: [class: "join-item btn btn-outline mr-4"],
          pagination_list_attrs: [class: "join"],
          ellipsis_attrs: [class: "join-item btn btn-disabled"]
        ]}
      />
    </div>
  </article>
</div>
