<section class="m-4">
  <h1>Feature Flags</h1>
  <form>
    <ul>
      <ol :for={flag <- @flags} class="m-2">
        <label>
          <input type="hidden" name={flag.id} value="false" />
          <input
            type="checkbox"
            phx-change="toggle"
            id={flag.id}
            name={flag.id}
            value="true"
            checked={flag.enabled}
          />
          {flag.name}
        </label>
      </ol>
    </ul>
  </form>
</section>
