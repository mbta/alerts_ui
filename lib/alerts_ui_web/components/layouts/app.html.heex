<header class="bg-sky-400">
  <div class="flex items-center justify-between border-b border-zinc-100 py-3 text-sm">
    <div class="flex items-center gap-4 mx-4">
      <a href="/">
        🚌
      </a>
    </div>
    <div class="flex items-center gap-4 font-semibold leading-6 text-zinc-900 mx-4">
      <a href="/alerts" class="hover:text-zinc-700">
        View Alerts
      </a>
      <a href="/alerts/new" class="hover:text-zinc-700">
        Create an Alert
      </a>
      <a :if={@show_components_page} href="/components" class="hover:text-zinc-700">
        Components
      </a>
      <a :if={@show_validate_page} href="/validate" class="hover:text-zinc-700">
        Validate Feeds
      </a>
    </div>
  </div>
</header>
<main class="min-h-screen">
  <div class="mx-auto max-w-full">
    <.flash_group flash={@flash} />
    <%= @inner_content %>
  </div>
</main>
