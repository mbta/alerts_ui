<div class="flex flex-col md:h-screen">
  <.application_header
    environment={@environment}
    show_alerts_table={@show_alerts_table}
    show_components_page={@show_components_page}
    show_validate_page={@show_validate_page}
    current_user={@current_user}
  />
  <main class="md:overflow-auto">
    <.live_component
      :if={@current_user}
      module={AlertsUIWeb.ActivityTracker}
      id="activity_tracker"
      last_auth_time={@last_auth_time}
      last_active={@last_active}
      current_user={@current_user}
    />
    <.flash_group flash={@flash} />
    {@inner_content}
  </main>
</div>
